{
  "version": 6,
  "configurePresets": [
    {
      "name": "strict",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/strict",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-19",
        "CMAKE_BUILD_TYPE": "Debug",
        "STREAMRIPPER_SANITIZER": "address-undefined"
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-19",
        "CMAKE_BUILD_TYPE": "Release",
        "STREAMRIPPER_SANITIZER": "none",
        "STREAMRIPPER_STATIC_MAD": "ON"
      }
    },
    {
      "name": "thread",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/thread",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-19",
        "CMAKE_BUILD_TYPE": "Debug",
        "STREAMRIPPER_SANITIZER": "thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "strict",
      "configurePreset": "strict",
      "jobs": 4
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    },
    {
      "name": "thread",
      "configurePreset": "thread",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "strict",
      "configurePreset": "strict",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "thread",
      "configurePreset": "thread",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
